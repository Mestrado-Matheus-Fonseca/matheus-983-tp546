# Compose uses its service name internally. Direct uv execution uses localhost.
MQTT_HOST=localhost
MQTT_PORT=1883
# As portas MQTT no host só são publicadas com compose.host-ports.yaml.
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_WS_PORT=9001
FRONTEND_PORT=3000
DEVICE_ID=room01
TOPIC_PREFIX=iot/environment
PUBLISH_INTERVAL=5
SCENARIO=normal
RANDOM_SEED=42
CO2_THRESHOLD=1500
CO2_HYSTERESIS=100
TEMPERATURE_THRESHOLD=30
TEMPERATURE_HYSTERESIS=1
HUMIDITY_LOW=30
HUMIDITY_HIGH=70
HUMIDITY_HYSTERESIS=3
LIGHT_THRESHOLD=200
LIGHT_HYSTERESIS=20
